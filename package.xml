<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orbslam3_dense_ros2</name>
  <version>1.5.0</version>
  <description>ORB-SLAM3 monocular, stereo, stereo-inertial and RGB-D tracking for ROS 2 Jazzy.</description>
  <maintainer email="azmyin12@gmail.com">Azmyin Md. Kamal</maintainer>
  <license>GPL 3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>

  <depend>ament_index_cpp</depend>
  <depend>message_filters</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libboost-serialization-dev</depend>
  <depend>libssl-dev</depend>
  <!-- Pangolin is installed from source; see scripts/install_pangolin.sh. -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
